#************************************************************************************************
#*            Verlet integration for colliding balls of different mass Balls                *
#************************************************************************************************
# Particle system with gravity, bounce, a bit of friction and Balls of different mass/size
# Balls collide and bounce of each other according to their mass
# Verlet integration has no explicit velocity defined. Velocity is derived from previous position
# Added the possibility to grab a ball and move it, displacing the other balls
#************************************************************************************************
#Globals to be used in the subroutines
#************************************************************************************************
global height, width, pos_x, pos_y, old_pos_x, old_pos_y
global rad, inv_mass, bounce, gravity, friction
global r, g, b, Balls, Ball, grab, grabr, grabinvm, Ball_lock, inv_mass
# Initialisations
#************************************************************************************************
call ScreenSetup()				# dimension & color
call WorldParameters()			# gravity, friction/drag, elasticity
call CreateBalls()	    		# location, old location, color, radius and derived mass
dim Ball_lock(Balls) fill 0     # if 1 then skip integration (Ball is currently held by mouse)
# mousedrag initialisation
grab  = -1
grabr = 15
# Drawing loop
#************************************************************************************************
while true
	call mousedrag(mousex, mousey, mouseb)
	call UpdateBalls()
	call DrawBalls()
end while

#here begin the subroutines
#************************************************************************************************
subroutine ScreenSetup()
	fastgraphics
	width = 1000: height = 1000
	graphsize width, height
	color black
	rect 0,0,width,height
	editvisible 0
	outputvisible 0
	refresh
end subroutine

subroutine WorldParameters()
	bounce = 0.5
	gravity = 0.5
	friction = 0.9999
end subroutine

subroutine CreateBalls()
	Balls = 150
	dim Ball(Balls,9)
	StartRad =4
    Max_inc = 20
	# Indices
	pos_x = 0 : pos_y = 1: old_pos_x = 2 : old_pos_y = 3: r = 4 : g = 5 : b = 6: rad = 7 : inv_mass = 8
	for i = 0 to Balls-1
		Ball[i,pos_x] = rand*width
		Ball[i,pos_y] = rand*height/2
		Ball[i,old_pos_x] = Ball[i,pos_x] - (rand*5 - 2.5)
		Ball[i,old_pos_y] = Ball[i,pos_y] - (rand*5 - 2.5)
		Ball[i,r] = 50 + (rand*155)
		Ball[i,g] = 50 + (rand*155)
		Ball[i,b] = 50 + (rand*155)
		Ball[i,rad] = StartRad + rand*Max_inc
		# Store inverse mass (1/mass) where mass = rad^2. if inv_mass = 0 then Ball is immovable
		Ball[i,inv_mass] = 1 / (Ball[i,rad] * Ball[i,rad])
	next i
end subroutine

subroutine UpdateBalls()
	# Update Positions (Integration)
	for i = 0 to Balls-1
		if Ball_lock[i] = 0 then
			vx = (Ball[i,pos_x] - Ball[i,old_pos_x]) * friction
			vy = (Ball[i,pos_y] - Ball[i,old_pos_y]) * friction
			Ball[i,old_pos_x] = Ball[i,pos_x]
			Ball[i,old_pos_y] = Ball[i,pos_y]
			Ball[i,pos_x] = Ball[i,pos_x] + vx
			Ball[i,pos_y] = Ball[i,pos_y] + vy + gravity
		endif
	next i

	# Collision Passes (after a bounce, a ball can end up in other ball so we iterate)
	for iter = 1 to 3
		# Ball-Ball Collisions
		for i = 0 to Balls-1
			for j = i + 1 to Balls - 1
				dx = Ball[i,pos_x] - Ball[j,pos_x]
				dy = Ball[i,pos_y] - Ball[j,pos_y]
				distance = sqr(dx * dx + dy * dy)
				SumRad = Ball[i,rad] + Ball[j,rad]

				if (distance < SumRad) and (distance > 0) then
					nx = dx / distance
					ny = dy / distance
					overlap = SumRad - distance

					# Inverse mass weighting: heavier moves less
					w1 = Ball[i,inv_mass]
					w2 = Ball[j,inv_mass]
					wsum = w1 + w2

					if wsum > 0 then
						push = overlap / wsum
						# Push ball i away along normal
						Ball[i,pos_x] = Ball[i,pos_x] + nx * push * w1
						Ball[i,pos_y] = Ball[i,pos_y] + ny * push * w1
						# Push ball j opposite direction along normal
						Ball[j,pos_x] = Ball[j,pos_x] - nx * push * w2
						Ball[j,pos_y] = Ball[j,pos_y] - ny * push * w2
					end if
				end if
			next j
		next i
		# Boundary Constraints
		for i = 0 to Balls-1
			# Recalculate current velocity after positional adjustments
			vx = Ball[i,pos_x] - Ball[i,old_pos_x]
			vy = Ball[i,pos_y] - Ball[i,old_pos_y]

			if Ball[i,pos_x] > width - Ball[i,rad] then
				Ball[i,pos_x] = width - Ball[i,rad]
				Ball[i,old_pos_x] = Ball[i,pos_x] + vx * bounce
			else
				if Ball[i,pos_x] < Ball[i,rad] then
					Ball[i,pos_x] = Ball[i,rad]
					Ball[i,old_pos_x] = Ball[i,pos_x] + vx * bounce
				endif
			endif

			if Ball[i,pos_y] > height - Ball[i,rad] then
				Ball[i,pos_y] = height - Ball[i,rad]
				Ball[i,old_pos_y] = Ball[i,pos_y] + vy * bounce
			else
				if Ball[i,pos_y] < Ball[i,rad] then
					Ball[i,pos_y] = Ball[i,rad]
					Ball[i,old_pos_y] = Ball[i,pos_y] + vy * bounce
				endif
			endif
		next i
	next iter
end subroutine

subroutine DrawBalls()
	# 3. Draw Points
	color black
	rect 0, 0, width, height
	for i = 0 to Balls-1
		color rgb(Ball[i,r], Ball[i,g], Ball[i,b])
		circle (Ball[i,pos_x], Ball[i,pos_y], Ball[i,rad])
	next i
	refresh
end subroutine

# mouse: grab the nearest ball; releasing keeps the last-tick velocity (a fling)
subroutine mousedrag(mx, my, mb)
   if mx < 0 then return                 # pointer left the window
   if mb & 1 then                        # left button held (bit 1)
      if grab = -1 then
         # grab the nearest free ball within reach / its radius
         best = -1 : bestd = 1000000000
         for i = 0 to Balls - 1
            if Ball_lock[i] = 0 then
               thr = grabr
               if Ball[i,rad] > thr then thr = Ball[i,rad]
               dx = Ball[i,pos_x] - mx : dy = Ball[i,pos_y] - my
               dd = dx * dx + dy * dy
               if dd < thr * thr then
                  if dd < bestd then bestd = dd : best = i
               end if
            end if
         next i
         if best >= 0 then
            grab = best
            grabinvm = Ball[grab,inv_mass]     # remember its real mass
            Ball_lock[grab] = 1            # freeze while held
            Ball[grab,inv_mass] = 0            # immovable to collisions too
            Ball[grab,pos_x] = mx : Ball[grab,pos_y] = my
            Ball[grab,old_pos_x] = mx : Ball[grab,old_pos_y] = my
         end if
      else
         # move the held ball, leaving a 1-tick velocity
         Ball[grab,old_pos_x] = Ball[grab,pos_x] : Ball[grab,old_pos_y] = Ball[grab,pos_y]
         Ball[grab,pos_x] = mx : Ball[grab,pos_y] = my
      end if
   else
      if grab >= 0 then
         Ball_lock[grab] = 0                  # release -> it keeps its velocity
         Ball[grab,inv_mass] = grabinvm           # restore its real mass
         grab = -1
      end if
   end if
end subroutine