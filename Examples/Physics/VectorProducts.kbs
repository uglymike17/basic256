#************************************************************************************************
#*                     Vector products - DOT, CROSS, NORM and UNIT at work                      *
#************************************************************************************************
# Four short scenes, each built on a single vector operator, so that what each one is for can be
# seen rather than described.  A vector here is just an array: {x,y} in two dimensions and
# {x,y,z} in three, and the operators read any array that has the right number of elements.
#
#   DOT   a number - how much two vectors point the same way.  Zero means at right angles.
#   CROSS three elements each gives a vector at right angles to both; two elements each gives
#         the single number that says which way round the two vectors turn.
#   NORM  the length of a vector.
#   UNIT  the same vector scaled to length one - a direction with the distance taken out.
#************************************************************************************************
# Definitions
#************************************************************************************************
global wide, high, mid_x, mid_y

wide = 500
high = 500
mid_x = wide / 2
mid_y = high / 2

graphsize wide, high
fastgraphics

call SceneOne()		#DOT   - the angle between two vectors
call SceneTwo()		#CROSS - which side of a line a point falls on
call SceneThree()	#UNIT  - a ball steered by a direction of length one
call SceneFour()	#CROSS in three dimensions - a surface lit by the way it faces

color black
text 10, high - 26, "that is all four"
refresh
end

#here begin the subroutines
#************************************************************************************************
subroutine Title(line$)
	# every scene opens the same way, with a clean page and a caption
	clg
	color black
	font "Verdana", 13, 50
	text 10, 10, line$
	font "Verdana", 11, 50
end subroutine

subroutine Arrow(x, y, v, arrowcolor)
	# draw the vector v as an arrow from x,y.  UNIT gives the direction on its own, which
	# is what the head of the arrow is built from - two short lines swung back from the
	# tip, the same size whatever the length of the arrow itself
	color arrowcolor
	penwidth 2
	tip_x = x + v[0,0]
	tip_y = y + v[0,1]
	line x, y, tip_x, tip_y
	d = unit(v)
	back_x = tip_x - d[0,0] * 12
	back_y = tip_y - d[0,1] * 12
	# the perpendicular of a direction dx,dy is -dy,dx
	line tip_x, tip_y, back_x - d[0,1] * 5, back_y + d[0,0] * 5
	line tip_x, tip_y, back_x + d[0,1] * 5, back_y - d[0,0] * 5
	penwidth 1
end subroutine

subroutine ShowFrame(seconds)
	refresh
	pause seconds
end subroutine

#************************************************************************************************
subroutine SceneOne()
	# DOT - the angle between two vectors.  a DOT b is norm(a) * norm(b) * cos(angle), so
	# dividing the dot product by the two lengths leaves the cosine of the angle on its own
	fixed = {140, 0}
	for degree = 0 to 350 step 10
		call Title("DOT - the angle between two arrows")
		turning = {140 * cos(radians(degree)), 140 * sin(radians(degree))}
		call Arrow(mid_x, mid_y, fixed, blue)
		call Arrow(mid_x, mid_y, turning, red)
		cosine = (fixed dot turning) / (norm(fixed) * norm(turning))
		color black
		text 10, 40, "fixed DOT turning = " + int(fixed dot turning)
		text 10, 60, "cos of the angle  = " + left(string(cosine), 6)
		text 10, 80, "angle             = " + int(degrees(acos(cosine))) + " degrees"
		if abs(fixed dot turning) < 1 then
			color red
			text 10, 110, "a dot product of zero means the two are at right angles"
		end if
		call ShowFrame(0.12)
	next degree
	call ShowFrame(1)
end subroutine

#************************************************************************************************
subroutine SceneTwo()
	# CROSS in two dimensions gives one number, and the sign of it says which way round the
	# two vectors turn - so it says which side of a line a point falls on, which is the
	# question behind hit testing, clipping and winding order
	from_x = 90
	from_y = 400
	to_x = 410
	to_y = 120
	along = {to_x - from_x, to_y - from_y}
	for step_along = 0 to 60
		call Title("CROSS in two dimensions - which side of the line?")
		color black
		penwidth 2
		line from_x, from_y, to_x, to_y
		penwidth 1
		point_x = 60 + step_along * 6
		point_y = 130 + step_along * 4
		toward = {point_x - from_x, point_y - from_y}
		side = along cross toward
		if side > 0 then
			color red
			whichside$ = "one side  (the cross product is positive)"
		else
			if side < 0 then
				color blue
				whichside$ = "the other (the cross product is negative)"
			else
				color green
				whichside$ = "exactly on the line (the cross product is zero)"
			end if
		end if
		circle point_x, point_y, 8
		color black
		text 10, 40, "along CROSS toward = " + int(side)
		text 10, 60, whichside$
		call ShowFrame(0.05)
	next step_along
	call ShowFrame(1)
end subroutine

#************************************************************************************************
subroutine SceneThree()
	# UNIT - a direction with the distance taken out.  The ball is pulled toward the mouse
	# at a steady speed however far away the pointer is, because what pulls it is UNIT of
	# the gap rather than the gap itself
	ball_x = mid_x
	ball_y = mid_y
	for frame = 1 to 400
		call Title("UNIT - a steady speed toward the mouse")
		gap = {mousex - ball_x, mousey - ball_y}
		distance = norm(gap)
		if distance > 2 then
			# unit(gap) has length 1, so multiplying by 3 is a speed of 3 pixels a frame
			heading = unit(gap)
			ball_x = ball_x + heading[0,0] * 3
			ball_y = ball_y + heading[0,1] * 3
		end if
		color grey
		line ball_x, ball_y, mousex, mousey
		color darkblue
		circle ball_x, ball_y, 12
		color black
		text 10, 40, "distance to the mouse = " + int(distance)
		text 10, 60, "the pull is UNIT of the gap, so the speed never changes"
		text 10, 80, "move the mouse over the graphics window"
		call ShowFrame(0.02)
	next frame
	call ShowFrame(1)
end subroutine

#************************************************************************************************
subroutine SceneFour()
	# CROSS in three dimensions - the vector at right angles to two others.  Two edges of a
	# triangle crossed together give the direction the surface faces, and DOT of that against
	# the direction of the light is how brightly it is lit.  That is the whole of flat
	# shading, in two statements
	light = unit({-0.4, -0.7, 1})
	for turn = 0 to 356 step 4
		call Title("CROSS in three dimensions - a lit surface")
		angle = radians(turn)
		# three corners of a triangle that turns about the upright axis
		call Corner(0, 0, 1.2, angle, ref(corner_a))
		call Corner(1.1, 0, -0.6, angle, ref(corner_b))
		call Corner(-1.1, 0.9, -0.6, angle, ref(corner_c))
		# two edges, and the way the surface faces is the direction at right angles to both
		mat sub edge_one = corner_b - corner_a
		mat sub edge_two = corner_c - corner_a
		facing = unit(edge_one cross edge_two)
		# how square on the surface is to the light, from 0 (edge on) to 1 (facing it)
		bright = facing dot light
		if bright < 0 then bright = 0
		shade = int(60 + bright * 195)
		color rgb(shade, int(shade / 2), 40)
		poly {ProjectX(corner_a), ProjectY(corner_a), ProjectX(corner_b), ProjectY(corner_b), ProjectX(corner_c), ProjectY(corner_c)}
		color black
		text 10, 40, "facing = UNIT(edge_one CROSS edge_two)"
		text 10, 60, "bright = facing DOT light = " + left(string(bright), 5)
		call ShowFrame(0.04)
	next turn
	call ShowFrame(1)
end subroutine

subroutine Corner(x, y, z, angle, ref(out))
	# one corner of the triangle, turned about the upright axis by angle
	out = {x * cos(angle) - z * sin(angle), y, x * sin(angle) + z * cos(angle)}
end subroutine

function ProjectX(p)
	# the flattest projection there is - throw the depth away and scale what is left
	return mid_x + p[0,0] * 150
end function

function ProjectY(p)
	return mid_y - p[0,1] * 150 - p[0,2] * 40
end function
