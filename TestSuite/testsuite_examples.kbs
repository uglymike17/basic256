# Where to find basic256 itself, relative to this TestSuite folder: next to
# it in an installed or unzipped copy, or in build/ in a source tree.
function findbasic256()
	if ostype = ostype_windows then
		dim places = {"../basic256.exe", "../build/Release/basic256.exe", "../build/basic256.exe"}
	else
		if ostype = ostype_macintosh then
			dim places = {"../basic256.app/Contents/MacOS/basic256", "../build/basic256.app/Contents/MacOS/basic256"}
		else
			dim places = {"../basic256", "../build/basic256"}
		end if
	end if
	for i = 0 to places[?]-1
		if exists(places[i]) then return currentdir + "/" + places[i]
	next i
	print "basic256 was not found next to the TestSuite folder."
	input "Type the full path of the basic256 program: ", typed
	return typed
end function

exe = findbasic256()
root = currentdir + "/../Examples/Original_Examples/"
if not exists(root) then
	print "The Examples/Original_Examples folder was not found next to the TestSuite folder."
	end
end if
print "Using " + exe
print

input "Start at example number (1 to " + examples[?] + ", Enter for 1): ", typed
start = 1
if typed <> "" then start = int(typed)

dq = chr(34)
failed = ""
failedcount = 0
for e = start - 1 to examples[?] - 1
	parts = explode(examples[e], "|")
	print
	print (e + 1) + " of " + examples[?] + ": " + parts[0]
	print "   " + parts[1]
	system dq + exe + dq + " -r " + dq + root + parts[0] + dq
	if yn(parts[0] + " worked?") then
		print "pass"
	else
		print "fail"
		failed = failed + "   " + (e + 1) + " " + parts[0] + chr(10)
		failedcount = failedcount + 1
	end if
next e

print
if failedcount = 0 then
	print "Every example worked."
else
	print failedcount + " examples did not work:"
	print failed;
end if
