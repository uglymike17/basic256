# turtle.kbs -- turtle graphics for BASIC-256.
#
# Only the turtle itself lives here. Everything else stays with the language's
# own graphics commands, and they apply to what the turtle draws exactly as
# they do to anything else: color sets the pen colour, penwidth its width,
# clg clears the canvas. To drop a circle or a label where the turtle is
# standing, feed it tu_x() and tu_y().
#
#     include "turtle.kbs"
#     color red
#     for n = 1 to 4
#        call tu_forward(100)
#        call tu_right(90)
#     next n
#     circle tu_x(), tu_y(), 5
#
# --- conventions -------------------------------------------------------------
#
# Angles are in DEGREES, measured clockwise from north. 
# The language's own sin and cos take radians, so the conversion
# is done here with the built-in radians() -- if you are holding
# an angle in radians already, pass degrees(a).
#
#       0 = north / up          90 = east / right
#     180 = south / down       270 = west / left
#
# Screen y grows DOWNWARD in BASIC-256, so north is -y and a right turn is
# clockwise on screen. The moves below account for that; nothing outside this
# file needs to think about it.
#
# The turtle starts in the middle of the graphics window, facing north, with
# its pen down. Nothing draws the turtle itself -- it leaves a trail, it is
# not a cursor.
#
# --- when the turtle is placed -----------------------------------------------
#
# On the first tu_ command the program issues, not when this file is included.
# That is deliberate: the starting point is the middle of the graphics window,
# and graphsize almost always comes AFTER the include, so a turtle placed at
# include time would centre itself on the window size it is about to stop
# having. Placing it on first use means graphsize can come in either order and
# the turtle still starts in the middle of the canvas you actually draw on.
#
# If you resize the window later, after the turtle has already moved, call
# tu_reset() to re-centre it on the new size.

# --- state -------------------------------------------------------------------
# Kept in globals rather than threaded through every call. They are spelled
# tu_state_* so they cannot collide with the tu_x() and tu_y() readback functions
# below: in BASIC-256 a function name and a variable name share one namespace,
# so a global named tu_x would make the function tu_x() unreachable.
#
# tu_state_ready is 0 until the turtle has been placed, and is set to 0 below
# rather than left to take that value by default. An unassigned variable does
# read as 0, but reading one is exactly what the 'Runtime Handling of variable
# not assigned' setting warns about, so every turtle program used to open with
# two warnings before it had drawn anything -- that one, and a conversion
# warning for the empty string it reads as being compared against 0.
#
# The other four are written by tu_reset() before anything can read them, so
# they need no line of their own.
#
# The assignment runs where the INCLUDE sits, which does not place the turtle
# any earlier -- that is still done by the first tu_ command, for the reason
# given above. It does mean the INCLUDE wants to be somewhere the program
# actually reaches: written after an END it never runs and the two warnings
# come back, though the turtle itself works either way.
global tu_state_x, tu_state_y, tu_state_h, tu_state_pen, tu_state_ready
tu_state_ready = 0

# tu_ensure() -- place the turtle if it has not been placed yet. Every command
# below starts with this, so the first one to run finds a turtle on the canvas.
# Not meant to be called from a program; call tu_reset() instead.
subroutine tu_ensure()
   if tu_state_ready = 0 then
      call tu_reset()
   endif
end subroutine

# --- placing the turtle ------------------------------------------------------

# tu_reset() -- back to the defaults: centred on the graphics window as it is
# now, facing north, pen down. Draws nothing on its way, whatever the pen was
# doing. Also the way to re-centre the turtle after a graphsize.
subroutine tu_reset()
   tu_state_x = graphwidth / 2
   tu_state_y = graphheight / 2
   tu_state_h = 0
   tu_state_pen = 1
   tu_state_ready = 1
end subroutine

# tu_goto(x, y) -- put the turtle at x,y. Draws a line there if the pen is
# down, so tu_penup first to move without a trail. The heading is untouched:
# the turtle is carried to the new spot, not turned toward it.
subroutine tu_goto(x, y)
   call tu_ensure()
   if tu_state_pen then line tu_state_x, tu_state_y, x, y
   tu_state_x = x
   tu_state_y = y
end subroutine

# tu_home() -- back to the middle of the graphics window, drawing if the pen
# is down. Heading and pen are left as they are; tu_reset() is the one that
# puts everything back.
subroutine tu_home()
   call tu_ensure()
   call tu_goto(graphwidth / 2, graphheight / 2)
end subroutine

# --- moving ------------------------------------------------------------------

# tu_forward(d) -- d pixels along the current heading, drawing if the pen is
# down. A negative d backs up, so this is tu_backward's twin.
subroutine tu_forward(d)
   call tu_ensure()
   nx = tu_state_x + d * sin(radians(tu_state_h))
   ny = tu_state_y - d * cos(radians(tu_state_h))
   if tu_state_pen then line tu_state_x, tu_state_y, nx, ny
   tu_state_x = nx
   tu_state_y = ny
end subroutine

# tu_backward(d) -- d pixels opposite the current heading. The turtle reverses;
# it does not turn round, so the heading is unchanged.
subroutine tu_backward(d)
   call tu_forward(-d)
end subroutine

# --- turning -----------------------------------------------------------------
# Headings are folded back into 0 <= h < 360 as they change, so they stay
# readable in the debugger and tu_getheading() never hands back 3600.

# tu_right(a) -- turn a degrees clockwise, without moving.
subroutine tu_right(a)
   call tu_ensure()
   tu_state_h = tu_state_h + a
   tu_state_h = tu_state_h - 360 * floor(tu_state_h / 360)
end subroutine

# tu_left(a) -- turn a degrees anticlockwise, without moving.
subroutine tu_left(a)
   call tu_right(-a)
end subroutine

# tu_setheading(a) -- face a degrees clockwise from north, whatever the turtle
# was facing before. The absolute counterpart to tu_right and tu_left.
subroutine tu_setheading(a)
   call tu_ensure()
   tu_state_h = a - 360 * floor(a / 360)
end subroutine

# --- the pen -----------------------------------------------------------------
# Only whether the pen draws lives here. What it draws with -- colour, width --
# is the language's own color and penwidth, and applies to the turtle's lines
# the moment you set it.

# tu_pendown() -- the turtle leaves a trail from here on.
subroutine tu_pendown()
   call tu_ensure()
   tu_state_pen = 1
end subroutine

# tu_penup() -- the turtle moves without drawing from here on.
subroutine tu_penup()
   call tu_ensure()
   tu_state_pen = 0
end subroutine

# tu_x() -- the turtle's x position.
function tu_x()
   call tu_ensure()
   return tu_state_x
end function

# tu_y() -- the turtle's y position.
function tu_y()
   call tu_ensure()
   return tu_state_y
end function

# tu_getheading() -- the heading in degrees, 0 <= h < 360, clockwise from north.
# Named getheading rather than heading so it cannot be confused with
# tu_setheading, which is the one that moves the turtle.
function tu_getheading()
   call tu_ensure()
   return tu_state_h
end function

# tu_getpen() -- 1 if the pen is down, 0 if it is up. Handy for leaving the pen
# as you found it:  p = tu_getpen() ... if p then call tu_pendown()
function tu_getpen()
   call tu_ensure()
   return tu_state_pen
end function

# tu_fw(d) -- tu_forward.
subroutine tu_fw(d)
   call tu_forward(d)
end subroutine

# tu_bw(d) -- tu_backward.
subroutine tu_bw(d)
   call tu_backward(d)
end subroutine

# tu_r(a) -- tu_right.
subroutine tu_r(a)
   call tu_right(a)
end subroutine

# tu_l(a) -- tu_left.
subroutine tu_l(a)
   call tu_left(a)
end subroutine

# tu_pd() -- tu_pendown.
subroutine tu_pd()
   call tu_pendown()
end subroutine

# tu_pu() -- tu_penup.
subroutine tu_pu()
   call tu_penup()
end subroutine

subroutine tu_help()
print " Placing the turtle"
print " ******************"
print " tu_reset() -- back to the defaults: centred, facing north, pen down."
print " tu_goto(x, y) -- put the turtle at x,y. Draws a line there if the pen is"
print " down, so tu_penup first to move without a trail. The heading is untouched."
print " tu_home() -- back to the middle of the graphics window, drawing if pendown."
print " Moving"
print " *******"
print " tu_forward(d) -- d pixels along the current heading, drawing if the pen is"
print " 		down. A negative d backs up, so this is tu_backward's twin."
print " tu_backward(d) -- d pixels opposite the current heading. The turtle reverses;"
print " 		it does not turn round, so the heading is unchanged."
print " Turning "
print " *******"
print " tu_right(a) 	-- turn a degrees clockwise, without moving."
print " tu_left(a) 	-- turn a degrees anticlockwise, without moving."
print " tu_setheading(a) -- face a degrees clockwise from north, whatever the turtle"
print " 			was facing before. The absolute counterpart to tu_right and tu_left."
print " The pen"
print " *********"
print " What it draws with -- colour, width -- is the language's own color and penwidth"
print " tu_pendown() -- the turtle leaves a trail from here on."
print " tu_penup() -- the turtle moves without drawing from here on."
print " Reading turtle"
print " **************"
print " tu_x() -- the turtle's x position."
print " tu_y() -- the turtle's y position."
print " tu_getheading() -- the heading in degrees, 0 <= h < 360, clockwise from north."
print " tu_getpen() -- 1 if the pen is down, 0 if it is up. Handy for leaving the pen"
print " 			as you found it:  p = tu_getpen() ... if p then call tu_pendown()"
print " Short aliases"
print " *************"
print " tu_fw(d) -- tu_forward."
print " tu_bw(d) -- tu_backward."
print " tu_r(a) -- tu_right."
print " tu_l(a) -- tu_left."
print " tu_pd() -- tu_pendown."
print " tu_pu() -- tu_penup."
end subroutine
